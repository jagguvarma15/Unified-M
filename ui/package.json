    "check:bundle": "bun run build && node ./scripts/check-budgets.mjs"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-query": "^5.75.0",
    "echarts": "^5.6.0",
    "lucide-react": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.6"
  }
}
